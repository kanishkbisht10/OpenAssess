# OpenAssess Environment Variables Configuration

# General Application Settings
PROJECT_NAME="OpenAssess"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="insecure-secret-key-change-in-production-min-32-chars-long"

# CORS Configuration (comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="openassess"

# Full SQLAlchemy Database URL
# For Docker: postgresql+psycopg://postgres:postgres_secure_password@postgres:5432/openassess
# For local dev without Postgres: sqlite+aiosqlite:///./openassess.db or sqlite:///./openassess.db
DATABASE_URL="postgresql+psycopg://postgres:postgres_secure_password@localhost:5432/openassess"

# Redis Cache and Queue Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# Frontend Configuration (exposed to client during build)
VITE_API_URL="http://localhost:8000"
